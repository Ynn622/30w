# 公開 API base URL；修改後需重新啟動 dev server 或重新建置。
VITE_API_BASE_URL=https://30wbackend.idfc.dev/api/v1


# api 模式下，後端確認 POST reports 已支援 intensity 後才設為 true；否則維持舊 body 且不詢問強度。
# 後端無法連線而改用模擬資料時，強度選項仍可操作，但不會上傳。
VITE_REPORT_INTENSITY=false

# 探索地圖的場所查詢半徑 = 地圖長邊的一半。後端 places 已接受任意正整數半徑（Ynn622/30w#4），
# 預設 true 送精確半徑（100–20000 公尺）並帶 max=100；設為 false 退回只送 300／500／1000。
VITE_PLACES_FREE_RADIUS=true

# 預設資料模式：live（正式資料）或 remote-hourly（後端 test/mock/hourly 逐小時模擬網格，Ynn622/30w#5）。
# 使用者仍可在「我的 › 測試資料」切換，選擇會記在此裝置。remote-hourly 僅供測試與展示，
# 後端 CORS 只允許 localhost:5173 與 GitHub Pages。修改後需重新啟動 dev server 或重新建置。
VITE_DATA_MODE=live

# 經緯度轉地址的服務網址（Nominatim 相容 /reverse 接口）。預設為 OpenStreetMap 公用伺服器，
# 需遵守其使用規範；正式交付建議改成後端轉送或自架 Nominatim。修改後需重新建置。
# VITE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# 固定測試位置：true 時不呼叫 App／瀏覽器定位，一律使用臺北市天母體育館（士林區），並跳通知標示非實際定位。
# false 或未設定時維持原本的裝置定位。修改後需重新啟動 dev server 或重新建置。
VITE_FAKE_LOCATION=false

# 展示用：true 時探索地圖的感官格網一律使用模擬資料（不呼叫 sensory/map），仍標示「模擬資料」並跳通知；
# 場所清單與首頁概況照常呼叫後端。正式上架請維持 false。修改後需重新啟動 dev server 或重新建置。
VITE_MOCK_MAP=false
